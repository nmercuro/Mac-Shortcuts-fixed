#!/bin/bash
# Adapt MiraBox startup information using macOS tools. Python is not required.
set -eu
PLUGIN_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
ORIGINAL_EXEC="$PLUGIN_DIR/StreamDeck-Shortcuts"
LOG_DIR="$HOME/Library/Logs/MiraBox-Shortcuts"
/bin/mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/launcher.log"
if [[ -f "$LOG_FILE" ]]; then /bin/mv -f "$LOG_FILE" "$LOG_FILE.previous"; fi
exec 2>>"$LOG_FILE"
fail() { printf 'Mac Shortcuts: %s\n' "$1" >&2; exit 1; }
PORT=""
PLUGIN_UUID=""
REGISTER_EVENT=""
INFO=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -port|-pluginUUID|-registerEvent|-info)
            [[ $# -ge 2 ]] || fail "Missing value for $1."
            case "$1" in
                -port) PORT="$2" ;;
                -pluginUUID) PLUGIN_UUID="$2" ;;
                -registerEvent) REGISTER_EVENT="$2" ;;
                -info) INFO="$2" ;;
            esac
            shift 2 ;;
        *) shift ;;
    esac
done
[[ "$PORT" =~ ^[0-9]{1,5}$ ]] || fail 'Invalid WebSocket port.'
(( 10#$PORT > 0 && 10#$PORT <= 65535 )) || fail 'WebSocket port is out of range.'
[[ -n "$PLUGIN_UUID" && -n "$REGISTER_EVENT" && -n "$INFO" ]] || fail 'Missing Stream Dock startup arguments.'
[[ -x "$ORIGINAL_EXEC" ]] || fail 'StreamDeck-Shortcuts is missing or is not executable. Reinstall the repair package.'
MAC_VERSION="$(/usr/bin/sw_vers -productVersion)"
if ! FIXED_INFO="$(/usr/bin/osascript -l JavaScript "$PLUGIN_DIR/normalize-info.js" "$INFO" "$PLUGIN_UUID" "$MAC_VERSION")"; then
    fail 'Could not prepare startup information.'
fi
[[ -n "$FIXED_INFO" ]] || fail 'Startup information is empty.'
printf 'Starting Mac Shortcuts repair 1.0.1 on macOS %s.\n' "$MAC_VERSION" >&2
# Native debug output includes shortcut names, so discard it. Capture launch
# errors and exit status without copying private shortcut names into this log.
set +e
"$ORIGINAL_EXEC" stream-deck-command -port "$PORT" -pluginUUID "$PLUGIN_UUID" -registerEvent "$REGISTER_EVENT" -info "$FIXED_INFO" >/dev/null 2>/dev/null &
CHILD_PID=$!
trap 'kill "$CHILD_PID" 2>/dev/null || true' TERM INT HUP
wait "$CHILD_PID"
EXIT_STATUS=$?
printf 'Shortcuts helper exited with status %s.\n' "$EXIT_STATUS" >&2
exit "$EXIT_STATUS"
